# SQLFluff configuration
# https://docs.sqlfluff.com/
#
# Tuned to catch mistakes, not to impose a house style on SQL that is already
# written and readable. Every exclusion below is justified — a linter silenced
# without reasons is worse than no linter, because a green check then means
# nothing.

[sqlfluff]
dialect = snowflake
templater = raw

# Set to a limit that actually binds. The longest line in sql/ is 102 characters,
# so 110 leaves room without licensing unbounded growth. LT05 is deliberately NOT
# excluded — a line-length setting that no enabled rule reads is a config that
# lies about what it enforces.
max_line_length = 110

# Disabled, with reasons:
#
#   LT01  spacing — the DDL and FILE FORMAT blocks align values in a column
#         (FIELD_DELIMITER     = ','). That alignment is deliberate and makes a
#         30-option format readable at a glance; collapsing it to single spaces
#         would cost clarity and catch nothing.
#   LT02  indentation — same reason, applied to aligned column lists.
#   LT08  blank line after CTE — cosmetic.
#   LT09  select targets on separate lines — noisy on single-expression selects.
#   LT14  keyword newline — would force WHERE onto its own line inside the
#         one-line scalar subqueries of the validation view, where the whole
#         point is that each check reads as a single line.
#   CP02  identifier capitalisation — Snowflake's METADATA$FILENAME and
#         METADATA$FILE_ROW_NUMBER pseudo-columns, and the system roles
#         ACCOUNTADMIN / SYSADMIN, are uppercase by universal convention.
#         Lowercasing them to satisfy a rule would make the SQL less familiar
#         to anyone who works with Snowflake.
#   RF04  keywords as identifiers — false positive on this dialect. It flags
#         first_name, last_name and email, all of which create and load without
#         complaint in Snowflake; the tables in bronze prove it.
#   AL03  expression without alias — fires on the scalar subqueries in the
#         validation view's UNION ALL. Only the first SELECT of a UNION names
#         the output columns, so aliases on the remaining branches are ignored
#         by the engine: pure noise.
#   AM04  unknown column count from SELECT * — every use is a deliberate
#         passthrough of a stage or a view.
#   AM06  GROUP BY / ORDER BY reference consistency — has no satisfiable answer
#         in the validation queries, which are UNION ALL chains ordered by an
#         alias that only the first SELECT defines (ORDER BY status, where
#         status is IFF(actual = expected, ...)). Ordering by name is rejected
#         because the later branches have no such name; ordering by position is
#         rejected because the SELECT lists names. The rule was applied by hand
#         everywhere it does have an answer — every positional GROUP BY in the
#         transformation scripts was rewritten to name its columns, since
#         positional grouping silently follows a reordered SELECT to a different
#         result.
exclude_rules = LT01, LT02, LT08, LT09, LT14, CP02, RF04, AL03, AM04, AM06

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false
indented_using_on = true
implicit_indents = allow

[sqlfluff:layout:type:comma]
line_position = trailing

# Snowflake folds unquoted identifiers to uppercase, so written case is purely a
# readability choice. The convention here — uppercase keywords, functions, types
# and literals against lowercase snake_case identifiers — makes structure
# scannable at a glance.
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent

# Deliberately NOT excluded, though both currently report zero violations:
#
#   RF02  references.qualification — the only rule here that flags an
#         unqualified column in a multi-table query. The silver layer will join
#         master data to transactions, and an unqualified customer_id there
#         lints clean but fails at runtime with "ambiguous column name". AL01
#         does not cover this: it enforces the AS keyword when an alias is
#         present, it does not require one.
#   ST06  structure.column_order — costs nothing to leave on.
#
# Excluding a rule that fires zero times buys no quiet and forfeits future
# coverage.
